{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sts",
      "runtimeExecutable": ".venv-mlx/bin/sts",
      "runtimeArgs": [
        "--web-port",
        "8080",
        "--https-port",
        "8443"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "make",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": [
        "src-mac/make_page.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "make install",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": [
        "src-mac/make_page.py",
        "8766",
        "install"
      ],
      "port": 8766
    }
  ]
}
